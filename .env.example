APP_NAME="SIMOVA FARMA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://yourdomain.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simova_farma
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database

# ─────────────────────────────────────────────────────────────────
# Telegram Bot
# 1. Create a bot via @BotFather on Telegram
# 2. Copy the token to TELEGRAM_BOT_TOKEN
# 3. Set the bot username (without @) in TELEGRAM_BOT_USERNAME
# 4. After deploying, register the webhook:
#    php artisan simova:telegram:set-webhook
# ─────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=SimovaFarmaBot

# ─────────────────────────────────────────────────────────────────
# Mercado Pago
# 1. Access https://www.mercadopago.com.br/developers
# 2. Create/select your application
# 3. Copy the Access Token (production or sandbox)
# 4. In Developers > Webhooks, configure:
#    - URL: https://yourdomain.com/webhooks/mercadopago
#    - Events: subscription_preapproval
#    - Copy the generated secret to MERCADOPAGO_WEBHOOK_SECRET
# 5. Create a subscription plan and copy the checkout link to
#    MERCADOPAGO_CHECKOUT_URL (the /assinar route redirects to it)
# ─────────────────────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_CHECKOUT_URL=

# ─────────────────────────────────────────────────────────────────
# GNews API (optional, for article collection)
# Free plan: https://gnews.io/
# ─────────────────────────────────────────────────────────────────
GNEWS_API_KEY=

# ─────────────────────────────────────────────────────────────────
# AI Insights (optional)
# DeepSeek or OpenAI for generating article insights
# ─────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@simovafarma.com.br"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
