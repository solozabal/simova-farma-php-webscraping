# =============================================================================
# SIMOVA FARMA — Configurações de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o arquivo .env com valores reais!
# =============================================================================

APP_NAME="SIMOVA FARMA"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_URL=https://seudominio.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# =============================================================================
# LOGS
# =============================================================================
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# =============================================================================
# BANCO DE DADOS — Hostinger MySQL
# =============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u804007826_simovafarma
DB_USERNAME=u804007826_simovafarma
DB_PASSWORD=

# =============================================================================
# SESSAO E CACHE
# =============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=simovafarma_

# =============================================================================
# E-MAIL
# =============================================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@seudominio.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# TELEGRAM BOT — NUNCA exponha o token!
# Crie o bot em https://t.me/BotFather e copie o token aqui.
# =============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# =============================================================================
# MERCADO PAGO
# Obtido em https://www.mercadopago.com.br/developers/panel
# =============================================================================
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_PLAN_ID=97071df9885745109d916d7e60e3d4b7

# =============================================================================
# GNEWS API (plano free — https://gnews.io/)
# =============================================================================
GNEWS_API_KEY=

# =============================================================================
# IA — para geracao de insights (DeepSeek ou OpenAI)
# =============================================================================
AI_PROVIDER=deepseek
AI_API_KEY=

# =============================================================================
# VITE
# =============================================================================
VITE_APP_NAME="${APP_NAME}"
